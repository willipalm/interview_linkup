# Copy this file to .env (same folder) and paste each key right after its "=".
# .env is in .gitignore: never commit it or paste keys into chat.

# Claude: runs the agent (Sonnet 5.5) and the judge (Opus 5.5). Get it at console.anthropic.com > API keys
ANTHROPIC_API_KEY=
# Only if your key isn't scoped to a workspace: Console > Settings > Workspaces > copy the workspace ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# Search APIs under test. Leave one blank and the runner skips that arm.
# Linkup: app.linkup.so > API keys
LINKUP_API_KEY=
# Perplexity: perplexity.ai/account/api > API keys
PERPLEXITY_API_KEY=
# Parallel: platform.parallel.ai > API keys
PARALLEL_API_KEY=
